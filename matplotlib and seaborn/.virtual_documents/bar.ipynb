import matplotlib.pyplot as plt
with plt.xkcd():
    years = [1990, 1992, 1994, 1996, 1998, 2000, 2003, 2005, 2007, 2010]
    runs =  [500, 700, 1100, 1500, 1800, 1200, 1700, 1300, 900, 1500]
    plt.bar(years, runs)
    plt.xlabel('YEARS')
    plt.ylabel('RUNS')
    plt.title("Runs of per years")
    plt.grid(True)
    plt.show()


