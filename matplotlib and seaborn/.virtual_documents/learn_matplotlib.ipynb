import matplotlib.pyplot as plt
import numpy as np


a = [20,15,10,30]


b = [13,14,15,16]


x = (a)
y = (b)


plt.plot(x,'rd--', label = "ab")
plt.plot(y,'go--', label = "cd")
plt.xlabel('a,b')
plt.ylabel('c,d')
plt.title('Random graph')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()


#plt.style.available()
plt.style.available


plt.plot(x,'rd--', label = "ab")
plt.plot(y,'go--', label = "cd")
plt.xlabel('a,b')
plt.ylabel('c,d')
plt.title('Random graph')
plt.legend()
plt.style.use('ggplot')
plt.tight_layout()
plt.show()


with plt.xkcd():
    plt.plot(x,'rd--', label = "ab")
    plt.plot(y,'go--', label = "cd")
    plt.xlabel('a,b')
    plt.ylabel('c,d')
    plt.title('Random graph')
    plt.legend()
    #plt.style.use('seaborn-v0_8-bright')
    plt.grid(True)
    plt.tight_layout()
    plt.show()


for i in range(5):
    plt.plot(np.random.rand(4), linewidth=1,)
 
plt.title("Too Much Data Can Be Confusing!")
plt.grid(True)
plt.tight_layout()
plt.show()
